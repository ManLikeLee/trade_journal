# ============================================================
# TradeJournal Frontend — Environment Variables
# Copy this file to .env.local and fill in real values
# ============================================================

# Backend API base URL
# Must be 127.0.0.1, not localhost: the refresh cookie is SameSite=Strict,
# so the page and the API have to be the same site (see C6).
NEXT_PUBLIC_API_URL="http://127.0.0.1:5000/api"

