{
  "root": true,
  "extends": ["next/core-web-vitals"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": { "project": "./tsconfig.json" },
  "plugins": ["@typescript-eslint"],
  "ignorePatterns": [".next/", "node_modules/", "next.config.js", "*.config.js"],
  // BURN-DOWN — pre-existing violation counts when CI was introduced (C12):
  //   @typescript-eslint/no-explicit-any        32
  //   @typescript-eslint/no-floating-promises   16   (8 of them in the dead useTradeSocket.ts)
  //   @typescript-eslint/no-unused-vars          5
  //   no-console                                 1
  //
  // Set to "warn" so CI can be green today without a mass rewrite that would bury
  // every future diff. Raise each to "error" as its count reaches zero. The
  // backend runs all of these at "error" already, so they cannot regress there.
  "rules": {
    "@typescript-eslint/no-explicit-any": "warn",

    "@typescript-eslint/no-floating-promises": "warn",

    "no-console": ["warn", { "allow": ["warn", "error"] }],

    "@typescript-eslint/no-unused-vars": [
      "warn",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }
    ]
  }
}
